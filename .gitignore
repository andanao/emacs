custom.el
auto-save-list/
tmp/
var/
etc/
url/
.cache/
transient/
org-persist/
eshell/
dirvish/
tree-sitter/
request/

# Single-file state
bookmarks
history
projects
recentf
tramp
network-security.data
.org-id-locations
.mc-lists.el
.time-zones.el
modus-reload.log
async-bytecomp.log

# Editor and tooling scratch
.agent-shell/
